# Prefer OpenRouter (Claude via OpenRouter). Falls back to ANTHROPIC_API_KEY if unset.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=anthropic/claude-haiku-4.5
SCORE_THRESHOLD=60
FETCH_MAX_PER_QUERY=100
ENABLE_AF=1
ENABLE_BLOCKET=1
ENABLE_EMAIL=1
# Prebendegatan 6, Göteborg — 30 km radius
HOME_LAT=57.705034
HOME_LON=11.910129
RADIUS_KM=30
# Email via Resend (preferred when set)
RESEND_API_KEY=
RESEND_FROM=Job Finder <onboarding@resend.dev>
# Optional SMTP fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=1
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
DATA_DIR=data
OUTBOX_DIR=outbox
CV_DIR=CV
ROLES_FILE=roles.yaml
EMAIL_FILE=.email
